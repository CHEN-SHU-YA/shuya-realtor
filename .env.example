# 複製成 .env.local（本機）或填到部署平台的環境變數。
# 這個檔案本身不要放真實密碼，它會被提交進 Git。

# --- 後台存取控制（正式環境必填）---------------------------
# /admin/appointments 會顯示客戶姓名、電話、Email 與需求內容。
# 正式環境沒設定這兩個變數，後台會直接停用（回 503），不會裸奔。
ADMIN_USER=
ADMIN_PASS=

# --- 網站對外網址（選填）-----------------------------------
# 影響 canonical、Open Graph 圖片與結構化資料。
# 沒填會自動用 Vercel 給的網址；接自訂網域後再填正式網域。
NEXT_PUBLIC_SITE_URL=

# --- 說明 ---------------------------------------------------
# 預約資料寫在 data/appointments.json。
# 注意：Vercel 的檔案系統是唯讀且不持久的，部署後「送出預約」會寫入失敗。
# 要正式收單，需改接資料庫（Vercel Postgres / KV、Supabase 等），
# 只要替換 src/lib/appointment-store.ts 的讀寫實作即可，其餘程式不用動。
